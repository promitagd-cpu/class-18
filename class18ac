import random
playing = True
number = str(random.randint(0, 3))

print ("I will guess a number from zero to nine and you have to guess the number one digit at a time.")
print ("The game will end when you get one guess correct.")
while playing:
    guess = input("Give your best guess!: ")
    if number == guess:
        print("You win the game!")
        print ("The number was", number)
        break
    else:
        print("Sorry, that's not the correct number. Try again.\n")